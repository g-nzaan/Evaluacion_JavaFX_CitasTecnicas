<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="680.0" prefWidth="1200.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tecnoasistencia.controlador.CitaTecnicaController"
            style="-fx-background-color: #f8fafc; -fx-font-family: 'Segoe UI';">
    <top>
        <VBox spacing="4" style="-fx-background-color: #0f172a;">
            <padding><Insets top="14" right="24" bottom="14" left="24"/></padding>
            <Label text="TecnoAsistencia Nicaragua S.A." style="-fx-text-fill: #94a3b8; -fx-font-weight: bold;"/>
            <Label text="Módulo de Gestión de Citas Técnicas" style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold;"/>
        </VBox>
    </top>
    <center>
        <HBox spacing="20">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
            <!-- Se mantiene el orden: formulario izquierdo y tabla derecha. -->
            <VBox prefWidth="350" minWidth="350" spacing="14" style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-background-radius: 10; -fx-border-radius: 10;">
                <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                <Label text="Formulario de Citas" style="-fx-font-size: 16; -fx-font-weight: bold;"/>
                <Label text="Los campos con * son obligatorios."/>
                <Separator/>
                <GridPane hgap="10" vgap="12">
                    <columnConstraints>
                        <ColumnConstraints minWidth="75"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                    <Label text="ID:" GridPane.rowIndex="0"/>
                    <TextField fx:id="txtId" editable="false" promptText="Auto-generado" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    <Label text="Cliente: *" GridPane.rowIndex="1"/>
                    <ComboBox fx:id="cmbCliente" promptText="Seleccione un cliente" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    <Label text="Fecha: *" GridPane.rowIndex="2"/>
                    <DatePicker fx:id="dpFecha" promptText="Seleccione la fecha" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                    <Label text="Hora: *" GridPane.rowIndex="3"/>
                    <TextField fx:id="txtHora" promptText="HH:mm, ejemplo 09:30" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                    <Label text="Servicio: *" GridPane.rowIndex="4"/>
                    <TextField fx:id="txtServicio" promptText="Descripción del servicio" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                    <Label text="Estado: *" GridPane.rowIndex="5"/>
                    <ComboBox fx:id="cmbEstado" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
                </GridPane>
                <Separator/>
                <HBox spacing="10">
                    <Button fx:id="btnGuardar" text="Guardar" onAction="#handleGuardar" maxWidth="Infinity" HBox.hgrow="ALWAYS" style="-fx-background-color: #2563eb; -fx-text-fill: white;"/>
                    <Button fx:id="btnActualizar" text="Actualizar" onAction="#handleActualizar" disable="true" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                </HBox>
                <HBox spacing="10">
                    <Button fx:id="btnEliminar" text="Eliminar" onAction="#handleEliminar" disable="true" maxWidth="Infinity" HBox.hgrow="ALWAYS" style="-fx-background-color: #ef4444; -fx-text-fill: white;"/>
                    <Button text="Limpiar" onAction="#limpiarFormulario" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                </HBox>
                <Label text="Si registró un cliente en la otra pestaña, pulse Recargar para verlo aquí." wrapText="true" style="-fx-text-fill: #64748b;"/>
            </VBox>
            <VBox spacing="14" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-background-radius: 10; -fx-border-radius: 10;">
                <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                <Label text="Filtros de citas" style="-fx-font-size: 16; -fx-font-weight: bold;"/>
                <FlowPane hgap="10" vgap="10">
                    <Label text="Estado:"/>
                    <ComboBox fx:id="cmbFiltroEstado" prefWidth="135"/>
                    <Label text="Fecha:"/>
                    <DatePicker fx:id="dpFiltroFecha" prefWidth="145"/>
                    <Button text="Limpiar filtros" onAction="#handleLimpiarFiltros"/>
                    <Button text="Recargar" onAction="#cargarDatos"/>
                </FlowPane>
                <Separator/>
                <TableView fx:id="tblCitas" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                        <TableColumn fx:id="colCliente" text="Cliente" prefWidth="160"/>
                        <TableColumn fx:id="colFecha" text="Fecha" prefWidth="95"/>
                        <TableColumn fx:id="colHora" text="Hora" prefWidth="65"/>
                        <TableColumn fx:id="colServicio" text="Servicio" prefWidth="150"/>
                        <TableColumn fx:id="colEstado" text="Estado" prefWidth="100"/>
                    </columns>
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                </TableView>
                <Label fx:id="lblContador" text="Citas mostradas: 0 de 0" style="-fx-text-fill: #64748b;"/>
            </VBox>
        </HBox>
    </center>
</BorderPane>
        ```